# Apache 2.4 / METANET: Dateiendungen bleiben aus den öffentlichen URLs heraus.
Options -MultiViews -Indexes
DirectoryIndex index.html
RewriteEngine On

# Text komprimieren; bereits komprimierte Bilder und Videos nicht nochmals packen.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Wiederholte Besuche entlasten. HTML bleibt aktuell, die PHP-API behält no-store.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType text/javascript "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 week"
</IfModule>

# Interne Dateien bleiben auch bei einem vollständigen Upload nicht öffentlich.
# .well-known bleibt für Zertifikatsvalidierung erreichbar.
RewriteRule "(^|/)\.(?!well-known(?:/|$))" - [F,END]
RewriteRule "^(?:scripts|tests|docs|node_modules)(?:/|$)" - [F,END,NC]
RewriteRule "(?:^|/)(?:contact-config\.php|AGENTS\.md|package(?:-lock)?\.json|[^/]+\.(?:bak|backup|old|orig|sql|log)|[^/]+~)$" - [F,END,NC]

# Nur direkte Aufrufe alter Dateinamen umleiten, keine internen Zuordnungen.
# THE_REQUEST bleibt bei einer internen Umschreibung unverändert.
RewriteCond %{THE_REQUEST} "\s/+index\.html(?:[?\s])"
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} "\s/+kontakt\.html(?:[?\s])"
RewriteRule ^kontakt\.html$ /kontakt [R=301,L]

RewriteCond %{THE_REQUEST} "\s/+projekt\.html(?:[?\s])"
RewriteCond %{QUERY_STRING} "(?:^|&)projekt=([a-z0-9-]+)(?:&|$)"
RewriteRule ^projekt\.html$ /projekte/%1 [R=301,L,QSD]

# Generierte HTML-Dateien nur über ihre kanonischen Projekt-URLs öffnen.
RewriteCond %{THE_REQUEST} "\s/+projekt-(wiriehorn|rigi)\.html(?:[?\s])"
RewriteRule ^projekt-(wiriehorn|rigi)\.html$ /projekte/$1 [R=301,L,QSD]

# Unterseiten verwenden einheitlich keinen abschliessenden Schrägstrich.
RewriteRule ^kontakt/$ /kontakt [R=301,L]
RewriteRule ^projekte/([a-z0-9-]+)/$ /projekte/$1 [R=301,L]

# Medien, Scripts, Verzeichnisse und insbesondere die PHP-API normal ausliefern.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]

# Die Dateien bleiben im Hauptverzeichnis; die Browseradresse bleibt sauber.
RewriteRule ^kontakt$ kontakt.html [END]
RewriteRule ^projekte/(wiriehorn|rigi)$ projekt-$1.html [END]

# SECURITY:START — generiert durch scripts/build-seo.cjs
<IfModule mod_headers.c>
  Header onsuccess unset Content-Security-Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-BTXoNJVYTrqGDmeIjLJRUvnIuHi3gGvEW4Yn1vGPN40=' 'sha256-Pp2jj0ejgDqE+NoyQ26vgzIwak7kMuJBdHgvgkxuZsw='; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self'; frame-src https://erlebniskarte.wiriehorn.ch; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  Header onsuccess unset X-Content-Type-Options
  Header always set X-Content-Type-Options "nosniff"
  Header onsuccess unset X-Frame-Options
  Header always set X-Frame-Options "SAMEORIGIN"
  Header onsuccess unset Referrer-Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header onsuccess unset Permissions-Policy
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header onsuccess unset Strict-Transport-Security
  Header always set Strict-Transport-Security "max-age=86400"
</IfModule>
# SECURITY:END
